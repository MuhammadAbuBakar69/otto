# Everything here is optional. Copy to .env and fill what you need.
# Otto never reads a variable it does not need for the command you ran.

# --- model -------------------------------------------------------------------
# none   = built-in templates, no download, no account (default)
# ollama = a model already running on your machine: ollama serve
OTTO_MODEL_PROVIDER=none
OTTO_MODEL_NAME=llama3.2
OTTO_MODEL_HOST=http://127.0.0.1:11434

# --- sending -----------------------------------------------------------------
# dry_run = nothing leaves this machine (default)
# smtp    = real email from your own mailbox
OTTO_DELIVERY_MODE=dry_run

# A Google app password, not your account password:
# https://myaccount.google.com/apppasswords
OTTO_SMTP_USER=
OTTO_SMTP_PASSWORD=

# --- reading replies (optional) ----------------------------------------------
# Set replies.enabled = true in otto.json first.
OTTO_IMAP_USER=
OTTO_IMAP_PASSWORD=

# --- overrides ---------------------------------------------------------------
# OTTO_SENDER_EMAIL=
# OTTO_SENDER_NAME=
# OTTO_DATA_DIR=data
